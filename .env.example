# =========================================================================
# GTM Research Platform — environment (copy to .env, never commit .env)
# =========================================================================

# --- Apollo (contact enrichment: emails + phones) ---
APOLLO_API_KEY=
# Public webhook URL for async phone reveals (e.g. cloudflared tunnel + /apollo-webhook)
APOLLO_WEBHOOK_URL=

# --- LARA (TD SYNNEX internal AI, web search) — primary research/enrichment engine ---
LARA_API_URL=https://api.lara.tdsynnex.com/v1/chat/assistant
LARA_API_KEY=
# Thin generalist "research" agent (receives the built prompt as the user message)
LARA_RESEARCH_ASSISTANT_ID=
# Thin generalist "enrichment" agent (finds contacts + source URLs)
LARA_ENRICHMENT_ASSISTANT_ID=

# --- Azure OpenAI (deterministic tasks; research only if the deployment has web search) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=
# true only if this deployment supports web browsing/grounding
AZURE_OPENAI_WEB_SEARCH=false

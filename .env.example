# =========================================================================
# GTM Research Platform — environment TEMPLATE (copy to .env, never commit .env)
# Fill real values in .env (gitignored). Leave this file with EMPTY secrets.
# =========================================================================

# --- Apollo (contact enrichment: emails + phones) ---
APOLLO_API_KEY=
# Public webhook URL for async phone reveals (e.g. cloudflared tunnel + /apollo-webhook)
APOLLO_WEBHOOK_URL=
#
# Apollo API-key scopes REQUIRED by this app (grant these when creating the key):
#   api/v1/mixed_people/api_search          - people search (find decision-makers)
#   api/v1/people/match                     - person enrich (reveal email) + fire phone reveal
#   api/v1/mixed_companies/search           - resolve a company domain from a name
#   api/v1/webhook_result/show              - poll async phone-reveal results
#   api/v1/usage_stats/credit_usage_stats   - pre-flight credit check (lead + direct_dial balances)
# Optional:
#   api/v1/people/phone_enrichment_status   - alternative phone-reveal status
#   api/v1/usage_stats/api_usage_stats      - API call usage stats
#   api/v1/users/api_profile                - key identity only (NOT credits; not required)
# Apollo credit buckets (per docs): lead_credit = email reveals/enrich;
# direct_dial_credit = phone reveals; dialer = call minutes. MOST plans are UNIFIED:
# one shared pool (reported as lead_credit) funds emails (1 credit), phone reveals
# (~8), and enrich — so we treat lead_credit as the balance and do NOT gate phones on
# direct_dial (which is misleading on unified plans). Pre-flight blocks when the
# shared pool is 0 or the usage endpoint cannot be reached. Set
# APOLLO_PREFLIGHT_STRICT=false to proceed when the balance cannot be verified.
APOLLO_PREFLIGHT_STRICT=true

# Local API without Redis: true = daemon thread. Unset + Docker = Celery .delay().
# RUN_STAGES_IN_THREAD=false

# Rewrite contacts.csv / results.csv every N companies (always on cancel/end).
# Billed Apollo results still flush immediately.
GTM_CSV_CHECKPOINT_EVERY=25

# --- LARA (TD SYNNEX internal AI, web search) — primary research/enrichment engine ---
LARA_API_URL=https://api.lara.tdsynnex.com/v1/chat/assistant
# Generic fallback key (used if a per-agent key below is not set)
LARA_API_KEY=

# Research agent — thin generalist (receives the built prompt as the user message)
LARA_RESEARCH_API_KEY=
LARA_RESEARCH_ASSISTANT_ID=

# Enrichment agent — thin generalist (finds contacts + source URLs)
LARA_ENRICHMENT_API_KEY=
LARA_ENRICHMENT_ASSISTANT_ID=

# Schema-mapper agent — OPTIONAL, no web search (maps stakeholder spreadsheet
# columns to the canonical schema; receives headers + non-PII samples only)
LARA_SCHEMA_API_KEY=
LARA_SCHEMA_ASSISTANT_ID=

# Outreach agent — OPTIONAL, no web search (writes the personalized email copy;
# used by default for outreach, falls back to the built-in template if unset)
LARA_OUTREACH_API_KEY=
LARA_OUTREACH_ASSISTANT_ID=

# --- Azure OpenAI (deterministic tasks; research only if the deployment has web search) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=
# true only if this deployment supports web browsing/grounding
AZURE_OPENAI_WEB_SEARCH=false

# --- Azure AI Foundry (OpenAI v1 `responses` API; ensemble research member) ---
# Endpoint is the Foundry project's OpenAI-compatible base, ending in /openai/v1
AZURE_FOUNDRY_ENDPOINT=https://wayki-studio-development.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=gpt-5.6-sol

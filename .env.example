# =========================================================================
# GTM Research Platform — environment TEMPLATE (copy to .env, never commit .env)
# Fill real values in .env (gitignored). Leave this file with EMPTY secrets.
# =========================================================================

# --- Apollo (contact enrichment: emails + phones) ---
APOLLO_API_KEY=
# Public webhook URL for async phone reveals (e.g. cloudflared tunnel + /apollo-webhook)
APOLLO_WEBHOOK_URL=

# --- LARA (TD SYNNEX internal AI, web search) — primary research/enrichment engine ---
LARA_API_URL=https://api.lara.tdsynnex.com/v1/chat/assistant
# Generic fallback key (used if a per-agent key below is not set)
LARA_API_KEY=

# Research agent — thin generalist (receives the built prompt as the user message)
LARA_RESEARCH_API_KEY=
LARA_RESEARCH_ASSISTANT_ID=

# Enrichment agent — thin generalist (finds contacts + source URLs)
LARA_ENRICHMENT_API_KEY=
LARA_ENRICHMENT_ASSISTANT_ID=

# Schema-mapper agent — OPTIONAL, no web search (maps stakeholder spreadsheet
# columns to the canonical schema; receives headers + non-PII samples only)
LARA_SCHEMA_API_KEY=
LARA_SCHEMA_ASSISTANT_ID=

# Outreach agent — OPTIONAL, no web search (writes the personalized email copy;
# used by default for outreach, falls back to the built-in template if unset)
LARA_OUTREACH_API_KEY=
LARA_OUTREACH_ASSISTANT_ID=

# --- Azure OpenAI (deterministic tasks; research only if the deployment has web search) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=
# true only if this deployment supports web browsing/grounding
AZURE_OPENAI_WEB_SEARCH=false

# --- Azure AI Foundry (OpenAI v1 `responses` API; ensemble research member) ---
# Endpoint is the Foundry project's OpenAI-compatible base, ending in /openai/v1
AZURE_FOUNDRY_ENDPOINT=https://wayki-studio-development.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=gpt-5.6-sol
